<?xml version="1.0" encoding="utf-8"?>
<!--
  Android 12+: allowBackup="false" turns off cloud backups, but not the transfer to a new phone. Nothing of this
  app leaves the phone that way either: the vault moves only as an exported copy, encrypted with the master password.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
    </device-transfer>
</data-extraction-rules>
